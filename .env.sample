# Discord token
DISCORD_TOKEN=

# User authorization - comma-separated list of Discord user IDs allowed to invoke the agent
ALLOWED_USER_IDS=

# LLM provider configuration
CUSTOM_MODEL=moonshotai/kimi-k2-instruct
GROQ_API_KEY=

# Redis (optional)
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# Observability (optional)
TRACING=false
PHOENIX_API_KEY=

#tool api keys
EXA_API_KEY=
GOOGLE_API_KEY=
FIRECRAWL_API_KEY=