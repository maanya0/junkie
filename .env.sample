# Discord token
DISCORD_TOKEN=

# LLM provider configuration
CUSTOM_MODEL=moonshotai/kimi-k2-instruct
GROQ_API_KEY=

# Redis (optional)
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# Observability (optional)
TRACING=false
PHOENIX_API_KEY=

#tool api keys
EXA_API_KEY=
GOOGLE_API_KEY=
FIRECRAWL_API_KEY=

# Honcho Configuration (Memory & Personalization)
# Get your API key from: https://app.honcho.dev/api-keys
HONCHO_API_KEY=
HONCHO_WORKSPACE_ID=junkie-discord-bot
HONCHO_ENVIRONMENT=production
HONCHO_CONTEXT_TOKENS=2000

# Cold Start Configuration
BACKFILL_ACTIVE_DAYS=7           # Only backfill/sync channels active in last N days
HONCHO_QUICK_SYNC_MESSAGES=50    # Messages per channel for quick sync
HONCHO_QUICK_SYNC_CHANNELS=20    # Max active channels for quick sync
HONCHO_QUICK_SYNC_HOURS=24       # Consider channels active if message in last N hours
HONCHO_DERIVER_TIMEOUT=30        # Seconds to wait for Deriver processing
HONCHO_DEEP_SYNC=true            # Enable background deep sync

# Concurrency Optimization
SYNC_CONCURRENCY=5               # Parallel channels for message_sync
HONCHO_INGESTION_CONCURRENCY=5   # Parallel channels for Honcho quick sync
HONCHO_DEEP_SYNC_CONCURRENCY=3   # Parallel channels for Honcho deep sync