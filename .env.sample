# Discord token
DISCORD_TOKEN=

# LLM provider configuration
CUSTOM_MODEL=moonshotai/kimi-k2-instruct
GROQ_API_KEY=

# Redis (optional)
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# Observability (optional)
TRACING=false
PHOENIX_API_KEY=

#tool api keys
EXA_API_KEY=
GOOGLE_API_KEY=
FIRECRAWL_API_KEY=

# Honcho Configuration (Memory & Personalization)
# Get your API key from: https://app.honcho.dev/api-keys
HONCHO_API_KEY=
HONCHO_WORKSPACE_ID=junkie-discord-bot
HONCHO_ENVIRONMENT=production
HONCHO_CONTEXT_TOKENS=2000